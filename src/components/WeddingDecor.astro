---
import diya from "../assets/illustrations/icon-diya.svg?url";
---
<div class="wedding-ambient" aria-hidden="true">
  <!-- flowers gently falling downward (generated by wedding.js) -->
  <div class="flower-fall-layer" id="flowerLayer" aria-hidden="true"></div>

  <!-- floating diyas drifting upward with flickering flames -->
  <div class="diya-layer">
    <img class="floating-diya" src={diya} alt=""/>
    <img class="floating-diya" src={diya} alt=""/>
    <img class="floating-diya" src={diya} alt=""/>
  </div>
</div>
<script src="../scripts/wedding.js"></script>
