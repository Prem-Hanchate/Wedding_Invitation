---
import { Image } from "astro:assets";
import photo1 from "../assets/photo1.jpeg";
import photo2 from "../assets/photo2.jpeg";
import photo3 from "../assets/photo3.jpeg";
import photo4 from "../assets/photo4.jpeg";
---
<section class="photo-section scroller-section">
  <div class="scroller-stage"><div class="scroller-invite-wrap">
    <div class="scroller-card" id="scrollerCard"><div class="scroller-card-inner">
      <div class="scroller-ornament"><span></span><b>◇</b><span></span></div>
      <h2 class="scroller-headline">Our forever starts here.</h2>
      <div class="scroller-photo-slot"><Image src={photo1} alt="Siddhesh and Priyanka" loading="eager" decoding="async" /><div class="scroller-slot-caption">19 · 12 · 2026</div></div>
      <div class="scroller-names">Siddhesh <span>&amp;</span> Priyanka</div>
      <div class="scroller-date-line">DECEMBER 19 · MUMBAI</div>
      <div class="scroller-ornament"><span></span><b>◇</b><span></span></div>
    </div><button type="button" class="scroller-click-btn" id="scrollerClickBtn" aria-label="Open the photo scroller"><span>Click<br>Me</span></button></div>
    <div class="scroller-reveal-stack" id="scrollerRevealStack">
      <div class="scroller-strip-photo"><Image src={photo1} alt="Engagement memories" loading="lazy" decoding="async" /><div class="scroller-cap">Engagement, Dec 2025</div></div>
      <div class="scroller-strip-photo"><Image src={photo2} alt="A proposal memory" loading="lazy" decoding="async" /><div class="scroller-cap">The proposal</div></div>
      <div class="scroller-strip-photo"><Image src={photo3} alt="A memory from their first trip" loading="lazy" decoding="async" /><div class="scroller-cap">First trip together</div></div>
      <div class="scroller-strip-photo"><Image src={photo4} alt="A shared home memory" loading="lazy" decoding="async" /><div class="scroller-cap">Home</div></div>
    </div>
    <p class="scroller-final-line" id="scrollerFinalLine">We can't wait to celebrate with you.</p>
  </div></div>
</section>
<script src="../scripts/photo-scroller.js"></script>
