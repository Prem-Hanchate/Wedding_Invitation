---
import { Image } from "astro:assets";
import photo1 from "../assets/photo1.jpeg";
import photo2 from "../assets/photo2.jpeg";
import photo3 from "../assets/photo3.jpeg";
import photo4 from "../assets/photo4.jpeg";
---
<section class="photo-section scroller-section">
  <div class="scroller-stage"><div class="scroller-invite-wrap">
    <div class="scroller-card" id="scrollerCard"><div class="scroller-card-inner">
      <div class="scroller-ornament"><span></span><b>◇</b><span></span></div>
      <h2 class="scroller-headline">Our forever starts here.</h2>
      <div class="scroller-photo-slot"><Image src={photo1} alt="Priyanka and Siddhesh" loading="eager" decoding="async" /><div class="scroller-slot-caption">19 · 12 · 2026</div></div>
      <div class="scroller-ornament"><span></span><b>◇</b><span></span></div>
    </div></div>
    <div class="scroller-reveal-stack ready" id="scrollerRevealStack">
      <div class="scroller-strip-track">
        <div class="scroller-strip-photo"><Image src={photo1} alt="Engagement memories" loading="eager" decoding="async" /><div class="scroller-cap"></div></div>
        <div class="scroller-strip-photo"><Image src={photo2} alt="A proposal memory" loading="eager" decoding="async" /><div class="scroller-cap"></div></div>
        <div class="scroller-strip-photo"><Image src={photo3} alt="A memory from their first trip" loading="eager" decoding="async" /><div class="scroller-cap"></div></div>
        <div class="scroller-strip-photo"><Image src={photo4} alt="A shared home memory" loading="eager" decoding="async" /><div class="scroller-cap"></div></div>
      </div>
    </div>
    <p class="scroller-final-line" id="scrollerFinalLine">We can't wait to celebrate with you.</p>
  </div></div>
</section>
<script src="../scripts/photo-scroller.js"></script>

<style>
  .scroller-photo-slot {
    width: min(100%, 220px);
    margin-inline: auto;
  }

  .scroller-photo-slot :global(img) {
    display: block;
    width: 100%;
    height: 180px;
    object-fit: cover;
    border-radius: 8px;
  }
</style>
