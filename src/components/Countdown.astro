<section class="countdown-section" id="countdown" aria-labelledby="countdownTitle">
  <div class="section-inner">
    <p class="section-label">Counting every moment</p>
    <h2 id="countdownTitle">Until we say <em>forever.</em></h2>
    <div class="countdown-grid" aria-label="Countdown to 19 December 2026">
      <div><strong id="days">00</strong><span>Days</span></div>
      <div><strong id="hours">00</strong><span>Hours</span></div>
      <div><strong id="minutes">00</strong><span>Minutes</span></div>
      <div><strong id="seconds">00</strong><span>Seconds</span></div>
    </div>
  </div>
</section>
