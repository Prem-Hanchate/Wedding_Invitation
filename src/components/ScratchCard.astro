<section class="scratch-section" aria-labelledby="scratchTitle">
  <div class="scratch-content">
    <p class="section-label">A little surprise</p>
    <h2 id="scratchTitle">Scratch to reveal<br><em>the big day.</em></h2>
    <div class="scratch-card" id="scratchCard">
      <div class="scratch-reveal-content">
        <p class="scratch-kicker">The big day</p>
        <strong>19 December 2026</strong>
        <span>Siddhesh &amp; Priyanka</span>
      </div>
      <canvas id="scratchCanvas" aria-label="Scratch to reveal the wedding date"></canvas>
      <div class="scratch-card-hint">Scratch gently across the gold</div>
    </div>
    <div class="scratch-progress" aria-hidden="true"><div id="scratchProgressBar"></div></div>
    <p class="scratch-status" id="scratchStatus" aria-live="polite">0% revealed</p>
  </div>
</section>
