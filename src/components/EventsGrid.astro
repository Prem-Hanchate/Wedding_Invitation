---
import garland from "../assets/illustrations/card-garland.svg?url";
import diya from "../assets/illustrations/icon-diya.svg?url";
import haldiImage from "../assets/haldi.png";
import mehendiImage from "../assets/mehendi.png";
import weddingImage from "../assets/wedding.png";
import receptionImage from "../assets/reception.png";
---
<section id="events" class="events-section">
  <div class="section-inner">
    <p class="section-label">The celebration</p>
    <h2>Wedding <em>Events</em></h2>
    <img src="../assets/illustrations/toran-divider.svg" alt="" class="section-divider" aria-hidden="true" loading="lazy"/>
    <div class="event-grid">
      <article class="event-card">
        <img src={garland} alt="" class="card-garland" aria-hidden="true" loading="lazy"/>
        <img src={mehendiImage.src} alt="Bride and groom during the Mehendi ceremony" class="event-image" loading="lazy"/>
        <div class="event-number">01</div>
        <p class="event-type">Celebration</p>
        <h3>Mehendi</h3>
        <p class="event-detail">17 December 2026</p>
        <p class="event-detail"></p>
        <img src={diya} alt="" class="card-lamp" aria-hidden="true" loading="lazy"/>
      </article>
      <article class="event-card">
        <img src={garland} alt="" class="card-garland" aria-hidden="true" loading="lazy"/>
        <img src={haldiImage.src} alt="Bride and groom during the Haldi ceremony" class="event-image" loading="lazy"/>
        <div class="event-number">02</div>
        <p class="event-type">Celebration</p>
        <h3>Haldi</h3>
        <p class="event-detail">18 December 2026</p>
        <p class="event-detail"></p>
        <img src={diya} alt="" class="card-lamp" aria-hidden="true" loading="lazy"/>
      </article>
      <article class="event-card">
        <img src={garland} alt="" class="card-garland" aria-hidden="true" loading="lazy"/>
        <img src={weddingImage.src} alt="Bride and groom at their wedding ceremony" class="event-image" loading="lazy"/>
        <div class="event-number">03</div>
        <p class="event-type">The Main Day</p>
        <h3>Lagna</h3>
        <p class="event-detail">19 December 2026</p>
        <p class="event-detail">Mumbai, Maharashtra</p>
        <img src={diya} alt="" class="card-lamp" aria-hidden="true" loading="lazy"/>
      </article>
      <article class="event-card">
        <img src={garland} alt="" class="card-garland" aria-hidden="true" loading="lazy"/>
        <img src={receptionImage.src} alt="Bride and groom at their wedding reception" class="event-image" loading="lazy"/>
        <div class="event-number">04</div>
        <p class="event-type">Together</p>
        <h3>Reception</h3>
        <p class="event-detail">19 December 2026</p>
        <p class="event-detail">Mumbai, Maharashtra</p>
        <img src={diya} alt="" class="card-lamp" aria-hidden="true" loading="lazy"/>
      </article>
    </div>
  </div>
</section>
